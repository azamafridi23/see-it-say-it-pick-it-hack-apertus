# Copy to .env and fill in. Never commit .env.
HF_TOKEN=          # Hugging Face token with access to facebook/sam3 (gated model)
APERTUS_API_KEY=   # key for the Apertus endpoint (any OpenAI-compatible server)
API_BASE_URL=https://hackapertus.livemap.sh/v1   # the Apertus server (path_b)
API_MODEL=apertus-v1.5-70b                       # the model on it (path_b)
