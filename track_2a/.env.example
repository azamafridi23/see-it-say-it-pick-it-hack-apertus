# Copy to .env and fill in. Never commit .env.
# The Hack Apertus template's variables; `make run` mounts this file into
# the container. Variables set in the shell take precedence over it.

# The key for the Apertus endpoint.
LLM_API_KEY=

# The endpoint: any OpenAI-compatible server.
LLM_BASE_URL=https://hackapertus.livemap.sh/v1

# The model on it.
LLM_NAME=apertus-v1.5-70b

# Older names still work: APERTUS_API_KEY, API_BASE_URL and API_MODEL.
# Optional: SAM3_MODEL=facebook/sam3 with HF_TOKEN=... loads the official
# (gated) SAM 3 repository.
HF_TOKEN=
