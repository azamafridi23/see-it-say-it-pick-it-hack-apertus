# Copy to .env and fill in. Never commit .env.
# The Hack Apertus template's variables; `make run` passes them to Docker.
LLM_API_KEY=                                     # key for the Apertus endpoint
LLM_BASE_URL=https://hackapertus.livemap.sh/v1   # the endpoint (any OpenAI-compatible server)
LLM_NAME=apertus-v1.5-70b                        # the model on it
# Older names still work: APERTUS_API_KEY, API_BASE_URL and API_MODEL.
# Optional: SAM3_MODEL=facebook/sam3 with HF_TOKEN=... loads the official (gated) SAM 3 repository.
HF_TOKEN=
