results*.json
*.raw.jsonl
__pycache__/
.DS_Store
.env
*.key
.venv/
track_2a/src/pipelines/*/out/
docs/adr
docs/figures
docs/report
docs/slides
report

# Secrets: every env file except the template
.env.*
!.env.example

# Model weights and caches: downloaded on first run, never committed
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
.cache/

# The app (apps/): dependencies, build output, local run data
node_modules/
.next/
*.tsbuildinfo
artifacts/simulator/

# Slides: generated intermediates (the sources and PDFs stay committable)
docs/slides/fig/canva/
docs/slides/*.txt

# Held-out runs stay out of git, except the submitted answers below.
results_heldout*
# The submitted held-out answers and their log are kept.
!/track_2a/results/results_heldout.json
/logs/
track_2a/results/logs/*
!/track_2a/results/logs/results_heldout.log.jsonl

# Path A prompt versions no longer used by the pipeline or the tests
track_2a/src/pipelines/path_a/prompts/agent_safety_v1.txt
track_2a/src/pipelines/path_a/prompts/agent_reference_v1.txt
track_2a/src/pipelines/path_a/prompts/agent_constraint_v2.txt
track_2a/src/pipelines/path_a/prompts/planner_v2.txt

# Scenes the jury adds: only the instructions and the calibration are committed
/track_2a/data/scenes/*
!/track_2a/data/scenes/README.md
!/track_2a/data/scenes/calibration.json
